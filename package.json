{
  "name": "marked-react",
  "version": "4.0.0",
  "description": "Render Markdown as React components",
  "keywords": [
    "markdown",
    "marked",
    "markedjs",
    "no dangerouslySetInnerHTML",
    "react"
  ],
  "homepage": "https://github.com/sibiraj-s/marked-react#readme",
  "bugs": "https://github.com/sibiraj-s/marked-react/issues",
  "license": "MIT",
  "author": "sibiraj-s",
  "repository": "github:sibiraj-s/marked-react",
  "files": [
    "dist/"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "oxlint .",
    "build": "tsdown",
    "dev": "storybook dev -p 7007",
    "build:storybook": "storybook build",
    "test": "vitest --coverage",
    "prepare": "is-ci || husky",
    "prepublishOnly": "is-ci || (npm run build && publint)"
  },
  "dependencies": {
    "html-entities": "^2.6.0",
    "marked": "^17.0.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@storybook/react": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.4",
    "commitlint-config-non-conventional": "^1.0.1",
    "highlight.js": "^11.12.0",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "publint": "^0.3.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-lowlight": "^3.1.1",
    "storybook": "^10.6.1",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  },
  "peerDependencies": {
    "react": "^16.8.0 || >=17.0.0"
  }
}
